{
  "name": "green-tasty-mcp-server",
  "version": "1.0.0",
  "description": "MCP server and OpenAPI bridge for Green & Tasty restaurant reservations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "green-tasty-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:stdio": "tsx src/index.ts --stdio",
    "start:prod": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "gemini-extension",
    "openapi",
    "restaurant",
    "reservations"
  ],
  "author": "Green & Tasty Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
