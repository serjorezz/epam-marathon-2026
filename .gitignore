# ==============================================================================
# Unified .gitignore for Green & Tasty (EPAM IT Marathon 6.0)
# Covers: General OS/IDEs, Terraform, Frontend (Angular), Backend (.NET), AQA
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Editors / IDEs
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.swp
*~
*.bak

# IDEs / Editors
.idea/
.vscode/
*.iml
*.code-workspace
.project
.classpath
.settings/
*.sublime-workspace
.c9/
*.launch
.history/
.ionide/

# AI Assistants & Agent state
.codemie/
/skills/

# ------------------------------------------------------------------------------
# Environment variables & local credentials (NEVER commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
credentials.*
credentials
admin-credentials.*

# ------------------------------------------------------------------------------
# Terraform / Cloud
# ------------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.disabled

# ------------------------------------------------------------------------------
# Frontend (Angular / Node.js)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-server/
tmp/
out-tsc/
.angular/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Angular build environment overrides (generated per environment)
src/environments/environment.production.ts
# Angular build environment overrides (generated per environment)

# ------------------------------------------------------------------------------
# Backend (.NET / / C#)
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific & local files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.vsp
*.psess

# Visual Studio & Rider temporary files
.vs/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.dotCover

# Reqnroll / SpecFlow generated code-behind
*.feature.cs

# Build & publishing outputs
publish/
*.publishproj
*.pubxml
*.azurePubxml
PublishScripts/
csx/
ecf/
rcf/
AppPackages/
BundleArtifacts/

# Python / Virtualenv
__pycache__/
*.py[cod]
.venv/
venv/
ENV/

# AWS Syndicate
.syndicate
bundles/

# OpenAPI / Swagger exports
export/
environment.production.ts
