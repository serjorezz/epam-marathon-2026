<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Restaurant_Aqa_Framework</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1031;CA1305;CA1812;CA1852;CA2007</NoWarn>
    <!-- `dotnet test`/`dotnet run` put TUnit's HTML/TRX/JSON next to Reqnroll's report and the traces (see Core/ArtifactPaths.cs). -->
    <TestingPlatformCommandLineArguments>--results-directory "$(MSBuildProjectDirectory)/TestResults"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="dotenv.net" Version="4.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Reqnroll.TUnit" Version="3.3.4" />
    <!-- Report Portal reporting (star task). Inert unless REPORTPORTAL_URL (and friends) are set —
         the suite runs unchanged without them. -->
    <PackageReference Include="ReportPortal.Reqnroll" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ReportPortal.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="TUnit" Version="1.72.10" />
  </ItemGroup>

</Project>
